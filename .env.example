# Email (Gmail SMTP)
# Use an App Password from Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=zeepro.services@gmail.com
SMTP_PASS=your-app-password-here

# WhatsApp Cloud API (Meta)
# Set up at https://developers.facebook.com > WhatsApp > Business Platform
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token

# Reviews (Upstash Redis)
# Create a free database at https://console.upstash.com and copy REST credentials
UPSTASH_REDIS_REST_URL=your-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Google Analytics 4 (optional)
# Get a Measurement ID at https://analytics.google.com > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX
